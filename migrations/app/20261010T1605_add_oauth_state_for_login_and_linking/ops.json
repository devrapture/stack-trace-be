        "sql": "CREATE TABLE \"public\".\"oauth_states\" (\n  \"client_type\" text NOT NULL,\n  \"consumed_at\" timestamptz(3),\n  \"created_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"expires_at\" timestamptz(3) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"intent\" text NOT NULL,\n  \"linking_user_id\" uuid NOT NULL,\n  \"nonce\" text,\n  \"pkce_verifier\" text,\n  \"provider\" text NOT NULL,\n  \"redirect_uri\" text NOT NULL,\n  \"state\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"oauth_states_client_type_check_a9640be8\" CHECK (\"client_type\" IN ('WEB', 'IOS', 'ANDROID', 'OTHER')),\n  CONSTRAINT \"oauth_states_intent_check_3c7e161e\" CHECK (\"intent\" IN ('LOGIN', 'LINK')),\n  CONSTRAINT \"oauth_states_provider_check_5918ff78\" CHECK (\"provider\" IN ('GOOGLE', 'GITHUB'))\n)",
        "params": []
      }
    ],
