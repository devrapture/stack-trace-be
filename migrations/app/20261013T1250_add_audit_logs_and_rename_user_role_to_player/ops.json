  {
    "id": "data.users.role.user_to_player",
    "label": "Rename existing USER roles to PLAYER",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "table": "users",
        "name": "role"
      }
    },
    "precheck": [
      {
        "description": "verify existing roles can be migrated",
        "sql": "SELECT NOT EXISTS (\n              SELECT 1\n              FROM \"public\".\"users\"\n              WHERE \"role\" NOT IN ('USER', 'PLAYER', 'ADMIN')\n            ) AS result"
      }
    ],
    "execute": [
      {
        "description": "rename USER roles to PLAYER",
        "sql": "UPDATE \"public\".\"users\"\n              SET \"role\" = 'PLAYER'\n              WHERE \"role\" = 'USER'"
      }
    ],
    "postcheck": [
      {
        "description": "verify no USER roles remain",
        "sql": "SELECT NOT EXISTS (\n              SELECT 1 FROM \"public\".\"users\" WHERE \"role\" = 'USER'\n            ) AS result"
      }
    ]
  },
