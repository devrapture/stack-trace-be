    "execute": [
      {
        "description": "create table \"audit_logs\"",
        "sql": "CREATE TABLE \"public\".\"audit_logs\" (\n  \"actor_user_id\" uuid,\n  \"created_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"event_type\" text NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"metadata\" jsonb,\n  \"user_id\" uuid,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"audit_logs_event_type_check_a7c68cf2\" CHECK (\"event_type\" IN ('PASSWORD_RESET', 'PASSWORD_CHANGED', 'PASSWORD_ADDED', 'PROVIDER_LINKED', 'PROVIDER_UNLINKED', 'ADMIN_ROLE_GRANTED', 'ADMIN_ROLE_REVOKED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"audit_logs\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"audit_logs\""
        ]
      }
    ]
  },
